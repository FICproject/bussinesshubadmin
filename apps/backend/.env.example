# ==========================================
# FIC BUSINESS HUB - BACKEND ENVIRONMENT VARIABLES (EXAMPLE TEMPLATE)
# Copy this file to .env and configure for your environment.
# ==========================================

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/fic_business_hub
MONGODB_TIMEOUT_MS=2500

# Security (Change in production!)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Seed accounts
SEED_SUPER_ADMIN_EMAIL=superadmin@ficapp.in
SEED_SUPER_ADMIN_PASSWORD=change_this_password
SEED_ADMIN_EMAIL=admin@ficapp.in
SEED_ADMIN_PASSWORD=change_this_password

PERSISTENCE_DIR=

